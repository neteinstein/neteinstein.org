{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neteinstein-org",
  "compatibility_date": "2026-08-01",

  // Pure static site: no Worker script, Cloudflare serves ./dist from the edge.
  // Static asset requests are free and do not count against Worker invocations.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
