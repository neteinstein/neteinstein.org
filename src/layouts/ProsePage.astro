---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';

interface Props {
  /** Filename (without extension) under `src/content/pages/`. */
  slug: string;
  /** Overrides the frontmatter title in <title> and <h1>. */
  title?: string;
  bareTitle?: boolean;
}

const { slug, title, bareTitle = false } = Astro.props;

const entry = await getEntry('pages', slug);
if (!entry) {
  throw new Error(`Missing content entry: src/content/pages/${slug}.mdx`);
}

const { Content } = await render(entry);
const heading = title ?? entry.data.title;
---

<BaseLayout title={heading} description={entry.data.description} bareTitle={bareTitle}>
  <PageHeader title={heading} lead={entry.data.lead} updated={entry.data.updated} />
  <Prose>
    <Content />
  </Prose>
  <slot />
</BaseLayout>
