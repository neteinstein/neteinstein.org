---
import type { ImageMetadata } from 'astro';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import { useI18n } from '../i18n';
import { getPage } from '../i18n/content';

/**
 * A page whose body is one MDX entry from `src/content/pages/`. Hero fields
 * come from the entry's frontmatter; the `hero` slot adds actions to it and
 * the default slot renders after the prose (for data-driven sections).
 */
interface Props {
  /** Filename (without extension) under `src/content/pages/`. */
  slug: string;
  /** Overrides the frontmatter title in <title> and <h1>. */
  title?: string;
  bareTitle?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  quote?: { text: string; author?: string };
}

const { slug, title, bareTitle = false, image, imageAlt, quote } = Astro.props;

const entry = await getPage(slug, useI18n(Astro).locale);

const { Content } = await render(entry);
const heading = title ?? entry.data.title;
---

<BaseLayout title={heading} description={entry.data.description} bareTitle={bareTitle}>
  <PageHero
    title={heading}
    eyebrow={entry.data.eyebrow}
    highlight={entry.data.highlight}
    lead={entry.data.lead}
    image={image}
    imageAlt={imageAlt}
    quote={quote}
  >
    <slot name="hero" slot="actions" />
  </PageHero>

  <div class="container-page py-6" data-reveal>
    <Prose>
      <Content />
    </Prose>
  </div>

  <slot />
</BaseLayout>
