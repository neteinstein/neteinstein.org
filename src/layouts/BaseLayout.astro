---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import avatar from '../assets/brand/avatar.webp';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIALS, navPages } from '../config/site';
import { withBase } from '../lib/url';
import { PERSON_ID as personId } from '../lib/schema';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_INFO,
  LOCALE_STORAGE_KEY,
  currentPage,
  localizePath,
  useI18n,
} from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Site-absolute path of the canonical URL, when it differs from this page's. */
  canonical?: string;
  /** Suppress the "| Pedro Vicente" suffix (used on the home page). */
  bareTitle?: boolean;
  /**
   * Site-absolute path to the social card. Defaults to `/og/<page>.jpg`, drawn
   * at build time from this page's title and description
   * (`src/integrations/og-cards.ts`); the home and 404 pages use the portrait
   * card in `public/`.
   */
  ogImage?: string;
  /**
   * Whether this page exists in every locale. Off for the 404 page, which
   * GitHub Pages serves at any missing URL.
   */
  translated?: boolean;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /**
   * Extra schema.org nodes for this page (apps, talks, …), added to the
   * JSON-LD graph next to the site, page and person nodes. `pageId`,
   * `personId` and `websiteId` below are the `@id`s to link them to.
   */
  schema?: Record<string, unknown>[];
}

const { locale, t } = useI18n(Astro);

const {
  title,
  description = t(SITE.description),
  canonical,
  bareTitle = false,
  ogImage: ogImageProp,
  translated = true,
  noindex = false,
  schema = [],
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} | ${SITE.title}`;
// The page's path with no base and no locale — the key shared by its translations.
const path = canonical ?? currentPage(Astro.url);
// Canonical URLs always name the custom domain, even on the github.io preview,
// so search engines never index the preview as a duplicate.
const canonicalUrl = new URL(localizePath(path, locale), SITE.url);
// Prefixed by hand rather than with `localizePath`, which leaves pages outside
// the nav (the easter egg) unprefixed and would give both languages one card.
const localePrefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const ogImage =
  ogImageProp ??
  (path === '/' || !translated
    ? SITE.ogImage
    : `/og${localePrefix}${path.replace(/\/+$/, '')}.jpg`);
const ogImageUrl = new URL(ogImage, SITE.url);

const alternates = translated
  ? LOCALES.map((alternate) => ({
      locale: alternate,
      url: new URL(localizePath(path, alternate), SITE.url).href,
      local: withBase(localizePath(path, alternate)),
    }))
  : [];
// Where a visitor whose browser prefers another language is sent on arrival.
// Only the default locale redirects, so an explicit /pt link always sticks.
const redirects =
  locale === DEFAULT_LOCALE
    ? Object.fromEntries(
        alternates
          .filter((alternate) => alternate.locale !== DEFAULT_LOCALE)
          .map((alternate) => [alternate.locale, alternate.local]),
      )
    : {};

// One linked JSON-LD graph per page: who the site is about, the site, this
// page and its place in the nav. Pages add their own nodes through `schema`.
const websiteId = `${SITE.url}/#website`;
const pageId = `${canonicalUrl.href}#webpage`;
const portrait = await getImage({ src: avatar, width: 400, format: 'jpeg' });
const homeUrl = new URL(localizePath('/', locale), SITE.url).href;
const navLabel = navPages().find((page) => page.href === path)?.label;
const isHome = path === '/';
// The 404 page sits outside the nav, so it gets no breadcrumb trail.
const hasBreadcrumb = !isHome && translated;
const graph = [
  {
    '@type': 'Person',
    '@id': personId,
    name: SITE.author,
    alternateName: SITE.handle,
    url: SITE.url,
    image: new URL(portrait.src, SITE.url).href,
    description: t(SITE.description),
    jobTitle: t('Mobile Services Lead & Improver'),
    worksFor: { '@type': 'Organization', name: 'Mindera', url: 'https://www.mindera.com' },
    knowsLanguage: LOCALES.map((alternate) => LOCALE_INFO[alternate].tag),
    sameAs: SOCIALS.map((social) => social.href),
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${SITE.url}/`,
    name: SITE.title,
    alternateName: SITE.handle,
    description: t(SITE.description),
    inLanguage: LOCALES.map((alternate) => LOCALE_INFO[alternate].tag),
    publisher: { '@id': personId },
  },
  {
    '@type': isHome ? 'ProfilePage' : 'WebPage',
    '@id': pageId,
    url: canonicalUrl.href,
    name: pageTitle,
    description,
    inLanguage: LOCALE_INFO[locale].tag,
    isPartOf: { '@id': websiteId },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl.href },
    ...(isHome ? { mainEntity: { '@id': personId } } : { author: { '@id': personId } }),
    ...(hasBreadcrumb && { breadcrumb: { '@id': `${canonicalUrl.href}#breadcrumb` } }),
  },
  ...(!hasBreadcrumb
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonicalUrl.href}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: t('Home'), item: homeUrl },
            {
              '@type': 'ListItem',
              position: 2,
              name: navLabel ? t(navLabel) : title,
              item: canonicalUrl.href,
            },
          ],
        },
      ]),
  ...schema,
];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang={LOCALE_INFO[locale].tag} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f0f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050708" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} — talks & articles`}
      href={withBase('/rss.xml')}
    />
    <link rel="canonical" href={canonicalUrl.href} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={LOCALE_INFO[alternate.locale].tag} href={alternate.url} />
    ))}
    {alternates
      .filter((alternate) => alternate.locale === DEFAULT_LOCALE)
      .map((alternate) => (
        <link rel="alternate" hreflang="x-default" href={alternate.url} />
      ))}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta
      name="robots"
      content={
        noindex
          ? 'noindex, follow'
          : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      }
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={LOCALE_INFO[locale].og} />
    {alternates
      .filter((alternate) => alternate.locale !== locale)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={LOCALE_INFO[alternate.locale].og} />
      ))}
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SITE.handle}`} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {/*
      Sends a first-time visitor whose browser prefers another language to this
      page's translation, before anything paints. A language picked in the
      header switcher is stored and always wins over the browser's.
    */}
    <script
      is:inline
      define:vars={{ redirects, fallback: DEFAULT_LOCALE, storageKey: LOCALE_STORAGE_KEY }}
    >
      (() => {
        try {
          if (localStorage.getItem(storageKey)) return;
        } catch {
          /* storage blocked — fall back to the browser's languages */
        }
        const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
          .map((tag) => (tag || '').toLowerCase().split('-')[0])
          .find((language) => language === fallback || language in redirects);
        const target = preferred && redirects[preferred];
        if (target) location.replace(target + location.search + location.hash);
      })();
    </script>
    {/* Runs before first paint so neither the theme nor the reveal state flashes. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
        } catch {
          /* private mode / storage blocked — the light default already applies */
        }

        // Motion is opt-in: hide reveal targets only when the motion runtime can
        // show them again. If it has not reported in by shortly after load
        // (blocked script, old browser), fall back to static content.
        if (
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          'IntersectionObserver' in window
        ) {
          root.classList.add('motion-ok');
          addEventListener('load', () =>
            setTimeout(() => {
              if (!window.__motionReady) root.classList.remove('motion-ok');
            }, 1200),
          );
        }
      })();
    </script>
    {/*
      Cookieless GoatCounter analytics, loaded only on the production host so
      local builds and the github.io preview never record pageviews.
    */}
    <script
      is:inline
      define:vars={{ endpoint: SITE.goatcounter, host: new URL(SITE.url).hostname }}
    >
      (() => {
        if (!endpoint || location.hostname !== host) return;
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://gc.zgo.at/count.js';
        script.dataset.goatcounter = `${endpoint}/count`;
        document.head.append(script);
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col overflow-x-clip">
    <div class="aurora" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div
      class="scroll-progress fixed inset-x-0 top-0 z-50 h-[3px] bg-[image:var(--gradient-brand)]"
      aria-hidden="true"
    ></div>

    <a
      href="#main"
      class="bg-surface-raised sr-only rounded-full px-4 py-2 shadow-[var(--shadow-md)] focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      {t('Skip to content')}
    </a>

    <Header translated={translated} />

    <!-- Curious? Not everything on this site is in the menu. -->
    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/motion.ts';
      import '../scripts/scroll-hide.ts';
    </script>
  </body>
</html>
