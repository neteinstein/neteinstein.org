---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIALS } from '../config/site';
import { stripBase, withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Site-absolute path of the canonical URL, when it differs from this page's. */
  canonical?: string;
  /** Suppress the "| Pedro Vicente" suffix (used on the home page). */
  bareTitle?: boolean;
  /** Site-absolute path to a page-specific social card under `public/`. */
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
  bareTitle = false,
  ogImage = SITE.ogImage,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} | ${SITE.title}`;
// Canonical URLs always name the custom domain, even on the github.io preview,
// so search engines never index the preview as a duplicate.
const canonicalUrl = new URL(canonical ?? stripBase(Astro.url.pathname), SITE.url);
const ogImageUrl = new URL(ogImage, SITE.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  alternateName: SITE.handle,
  url: SITE.url,
  jobTitle: 'Mobile Services Lead & Improver',
  worksFor: { '@type': 'Organization', name: 'Mindera', url: 'https://www.mindera.com' },
  sameAs: SOCIALS.map((social) => social.href),
};
---

<!doctype html>
<html lang={SITE.locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0b1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="canonical" href={canonicalUrl.href} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${SITE.handle}`} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {/* Runs before first paint so neither the theme nor the reveal state flashes. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
        } catch {
          /* private mode / storage blocked — the light default already applies */
        }

        // Motion is opt-in: hide reveal targets only when the motion runtime can
        // show them again. If it has not reported in by shortly after load
        // (blocked script, old browser), fall back to static content.
        if (
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          'IntersectionObserver' in window
        ) {
          root.classList.add('motion-ok');
          addEventListener('load', () =>
            setTimeout(() => {
              if (!window.__motionReady) root.classList.remove('motion-ok');
            }, 1200),
          );
        }
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col overflow-x-clip">
    <div class="aurora" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <div
      class="scroll-progress fixed inset-x-0 top-0 z-50 h-[3px] bg-[image:var(--gradient-brand)]"
      aria-hidden="true"
    >
    </div>

    <a
      href="#main"
      class="bg-surface-raised sr-only rounded-full px-4 py-2 shadow-[var(--shadow-md)] focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
