---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Icon from '../components/Icon.astro';
import * as donateData from '../data/donate';
import { useI18n } from '../i18n';
import { getPage } from '../i18n/content';

const { t, locale, localize, localHref } = useI18n(Astro);
const { showcase, options } = localize(donateData);
const page = (await getPage('donate', locale)).data;
---

<BaseLayout title={page.title} description={page.description}>
  <PageHero title={page.title} eyebrow={page.eyebrow} highlight={page.highlight} lead={page.lead}>
    <nav aria-label={t('Free apps and games')} class="mt-8" data-enter style="--delay: 450">
      <ul class="glass border-line flex max-w-2xl flex-wrap gap-2 rounded-[1.6rem] border p-2.5 shadow-[var(--shadow-md)]">
        {showcase.map((app) => (
          <li>
            <a
              href={localHref(app.href)}
              title={app.title}
              class="group focus-visible:ring-accent block rounded-[24%] transition-transform duration-300 ease-[var(--ease-spring)] hover:-translate-y-1 hover:scale-110 focus-visible:ring-2 focus-visible:outline-none"
            >
              <Image
                src={app.icon}
                alt={app.title}
                widths={[48, 96]}
                sizes="2.75rem"
                class="size-11 rounded-[24%] shadow-[var(--shadow-sm)]"
                loading="eager"
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </PageHero>

  <Section title={t('Choose how to chip in')}>
    <ul class="grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {options.map((option) => (
        <li class="border-line bg-surface-raised flex flex-col gap-5 rounded-3xl border p-7 shadow-[var(--shadow-md)] sm:p-8">
          <div class="flex items-center gap-3">
            <span class="bg-accent/10 text-accent flex size-12 items-center justify-center rounded-2xl">
              <Icon name={option.icon} class="size-6" />
            </span>
            <h3 class="font-display text-2xl font-bold tracking-tight">{option.title}</h3>
          </div>
          <p class="text-muted text-pretty">{option.description}</p>
          <div class="mt-auto">
            <ButtonLink href={option.href} icon={option.icon} size="lg">
              {option.cta}
            </ButtonLink>
          </div>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
