---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PullQuote from '../../components/hobbies/PullQuote.astro';
import JumpLinks from '../../components/hobbies/JumpLinks.astro';
import { mythGroups, mythsIntro } from '../../data/myths';

const entry = await getEntry('pages', 'myths');
if (!entry) throw new Error('Missing content entry: src/content/pages/myths.mdx');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHero
    title={entry.data.title}
    eyebrow={entry.data.eyebrow}
    highlight={entry.data.highlight}
    image={mythsIntro.figure.image}
    imageAlt={mythsIntro.figure.alt}
    imageFit="contain"
  >
    <div class="mt-6" data-enter style="--delay: 350">
      <p class="text-muted text-lg sm:text-xl">{mythsIntro.preface}</p>
      <PullQuote
        text={mythsIntro.quote.text}
        attribution={mythsIntro.quote.attribution}
        class="!mt-5 !mb-6"
      />
      <p class="font-display text-lg font-medium text-pretty italic sm:text-xl">
        {mythsIntro.stance}
      </p>
    </div>
    <JumpLinks slot="actions" items={mythGroups.map(({ id, title }) => ({ id, label: title }))} />
  </PageHero>

  <div class="container-page pb-10 sm:pb-16">
    <Content />
  </div>
</BaseLayout>
