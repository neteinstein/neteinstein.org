---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Prose from '../../components/Prose.astro';
import StoryTimeline from '../../components/hobbies/StoryTimeline.astro';
import StoryStats from '../../components/hobbies/StoryStats.astro';
import * as storyData from '../../data/stories';
import { useI18n } from '../../i18n';
import { getPage } from '../../i18n/content';

const { t, locale, localize } = useI18n(Astro);
const { jeepPhoto, stories } = localize(storyData);
const entry = await getPage('storyteller', locale);
const { Content } = await render(entry);

const years = stories.flatMap((story) => (story.year === undefined ? [] : [story.year]));
const span = `${Math.min(...years)} – ${Math.max(...years)}`;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHero title={entry.data.title} eyebrow={entry.data.eyebrow} highlight={entry.data.highlight}>
    <StoryStats count={years.length} span={span} />
  </PageHero>

  <Section id="bored">
    <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div data-reveal>
        <Prose>
          <Content />
        </Prose>
      </div>
      <figure class="relative mx-auto w-full max-w-md" data-reveal="scale">
        <div
          class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-[image:var(--gradient-brand)] opacity-25 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div class="animate-float">
          <div
            class="glow-ring border-line bg-surface-raised -rotate-2 rounded-[1.75rem] border p-2 shadow-[var(--shadow-lg)] transition-transform duration-700 ease-[var(--ease-spring)] hover:rotate-0"
          >
            <Image
              src={jeepPhoto.image}
              alt={jeepPhoto.alt}
              widths={[435]}
              sizes="(min-width: 448px) 28rem, 100vw"
              class="aspect-[16/9] w-full rounded-[1.4rem] object-cover"
            />
          </div>
        </div>
      </figure>
    </div>
  </Section>

  <Section id="stories" eyebrow={t('Timeline')}>
    <StoryTimeline items={stories} />
  </Section>
</BaseLayout>
