---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import JumpLinks from '../../components/hobbies/JumpLinks.astro';
import { hobbies as allHobbies } from '../../data/hobbies';
import { useI18n } from '../../i18n';
import { getPage } from '../../i18n/content';

const { locale, localize } = useI18n(Astro);
const hobbies = localize(allHobbies);
const entry = await getPage('hobbies', locale);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <PageHero title={entry.data.title} eyebrow={entry.data.eyebrow} highlight={entry.data.highlight}>
    <JumpLinks
      slot="actions"
      items={hobbies.map(({ id, shortTitle }) => ({ id, label: shortTitle }))}
    />
  </PageHero>

  <div class="container-page pb-10 sm:pb-16">
    <Content />
  </div>
</BaseLayout>
