---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Icon from '../components/Icon.astro';
import RichText from '../components/RichText.astro';
import GameFilter from '../components/games/GameFilter.tsx';
import CategoryTiles from '../components/games/CategoryTiles.astro';
import PdfCount from '../components/games/PdfCount.astro';
import ToolFeature from '../components/tools/ToolFeature.astro';
import { resolveGuide } from '../components/games/guide';
import { SITE, navPages } from '../config/site';
import * as games from '../data/games';
import { localizePath, useI18n } from '../i18n';
import avatar from '../assets/brand/avatar.webp';
import { getPage } from '../i18n/content';

const PATH = '/games';
const SUMMER_CAMP_ID = 'summer-camp-games';

const { t, locale, localize } = useI18n(Astro);
const { gameCategories, gamesDonate, gamesHero, summerCampGames } = localize(games);
const entry = await getPage('games', locale);
const { Content: HowToUse } = await render(entry);
const summerCamp = (await getPage(summerCampGames.page, locale)).data;

const navLabel = navPages().find((page) => page.href === PATH)?.label;
const pageName = navLabel ? t(navLabel) : entry.data.title;
const guide = await resolveGuide(gameCategories, (game) => t('Illustration: {game}', { game }));
const brandAvatar = await getImage({ src: avatar, width: 256, format: 'png' });
---

<BaseLayout title={pageName} description={entry.data.description}>
  <PageHero
    title={entry.data.title}
    eyebrow={entry.data.eyebrow}
    highlight={entry.data.highlight}
    lead={entry.data.lead}
    video={{ sources: gamesHero.sources, poster: gamesHero.poster, label: gamesHero.label }}
  >
    <p
      class="text-muted mt-3 max-w-2xl text-lg text-pretty sm:text-xl"
      data-enter
      style="--delay: 420"
    >
      {gamesDonate.question}
      <br />
      <RichText text={gamesDonate.text} />
    </p>
    <ButtonLink slot="actions" href="#guide" size="lg" trailing="arrow-down">
      {t('Jump to the games')}
    </ButtonLink>
  </PageHero>

  <Section id="how-to-use" eyebrow={t('Before you start')} title={t('How to use this guide')}>
    <div
      class="border-line bg-surface-raised relative overflow-hidden rounded-3xl border p-6 shadow-[var(--shadow-sm)] sm:p-8"
      data-reveal
    >
      <span
        class="text-accent-3 mb-4 grid size-11 place-items-center rounded-2xl bg-[color-mix(in_oklch,var(--accent-3)_16%,transparent)]"
        aria-hidden="true"
      >
        <Icon name="sparkles" class="size-5" />
      </span>
      <div class="text-muted flex max-w-3xl flex-col gap-4 text-lg leading-relaxed text-pretty [&_p]:m-0 [&_strong]:text-[var(--text)]">
        <HowToUse />
      </div>
    </div>
  </Section>

  <Section id="chapters" eyebrow={t('Jump to')} title={t('Pick a kind of game')}>
    <CategoryTiles
      categories={gameCategories}
      extra={{ label: summerCamp.title, href: `#${SUMMER_CAMP_ID}`, image: summerCampGames.image }}
    />
  </Section>

  <Section id="guide">
    <GameFilter
      client:visible
      categories={guide}
      labels={{
        search: t('Search the games'),
        placeholder: t('Search a game, a material, an age…'),
        category: t('Category'),
        setting: t('Indoor/Outdoor'),
        all: t('All'),
        count: t('{shown} of {total} games'),
        empty: t('Nothing matches those filters.'),
        clear: t('Clear the search'),
        game: t('{count} game'),
        games: t('{count} games'),
        players: t('Group'),
        age: t('Age'),
        duration: t('Duration'),
        where: t('Where'),
        howToPlay: t('How to play'),
        materials: t('Materials'),
        setup: t('Setup'),
        goal: t('Goal'),
        rules: t('Rules, step by step'),
        tips: t('Variations and tips'),
        sources: t('Original video:'),
        originalName: t('Original title:'),
        video: t('The original video'),
        playVideo: t('Play video:'),
        selectForPrint: t('Select for print'),
        backToView: t('Back to view'),
        savePdf: t('Save PDF'),
        saving: t('Preparing…'),
        selectHint: t('Tick the games to print'),
        selected: t('{count} selected'),
        select: t('Select'),
        selectSection: t('Select all'),
        unselectSection: t('Unselect all'),
        collapse: t('Collapse'),
        expand: t('Expand'),
      }}
      settings={[
        { value: 'indoor', label: t('Indoors') },
        { value: 'outdoor', label: t('Outdoors') },
      ]}
      print={{
        locale,
        brand: {
          name: SITE.author,
          host: new URL(SITE.url).host.replace(/^www\./, ''),
          url: new URL(localizePath(PATH, locale), SITE.url).href,
          avatar: brandAvatar.src,
        },
        labels: {
          title: entry.data.title,
          lead: t('A printable selection of {count} games'),
          reference: t('Reference'),
          online: t('Online version'),
          printed: t('Printed on {date}'),
          contents: t('Games in this booklet'),
          page: t('Page'),
          materialsNeeded: t('What to bring'),
          noMaterials: t('No materials needed'),
          players: t('Group'),
          age: t('Age'),
          duration: t('Duration'),
          where: t('Where'),
          materials: t('Materials'),
          setup: t('Setup'),
          goal: t('Goal'),
          rules: t('Rules, step by step'),
          tips: t('Variations and tips'),
          scoreTable: t('Score table'),
          scoreLead: t('Write a team or a player on each line, then their points under each game.'),
          name: t('Team / player'),
          total: t('Total'),
          file: t('group-games'),
        },
      }}
    />
  </Section>

  <Section id={SUMMER_CAMP_ID} width="default" eyebrow={t('And also')}>
    <ToolFeature
      title={summerCamp.title}
      href={summerCampGames.href}
      description={summerCamp.lead}
      links={summerCampGames.links}
      image={summerCampGames.image}
      imageAlt={summerCampGames.imageAlt}
    />
  </Section>

  <PdfCount />
</BaseLayout>
