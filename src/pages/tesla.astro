---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkCard from '../components/LinkCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { teslaLinks } from '../data/teslaLinks';
---

<BaseLayout title="Tesla" description="Websites that work well in the Tesla in-car browser.">
  <PageHeader
    title="Tesla"
    lead="A list of sites that actually work well inside the Tesla browser."
  />

  {
    teslaLinks.length === 0 ? (
      <EmptyState source="src/data/teslaLinks.ts" />
    ) : (
      <div class="grid gap-4 sm:grid-cols-2">
        {teslaLinks.map((entry) => (
          <LinkCard entry={entry} />
        ))}
      </div>
    )
  }
</BaseLayout>
