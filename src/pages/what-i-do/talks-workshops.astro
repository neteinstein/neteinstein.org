---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Marquee from '../../components/Marquee.astro';
import TalkHeroIntro from '../../components/talks/TalkHeroIntro.astro';
import TalkCategorySection from '../../components/talks/TalkCategorySection.astro';
import TalkLog from '../../components/talks/TalkLog.astro';
import {
  talkCategories,
  talkLog,
  talkStages,
  talkStats,
  talkTagTones,
  talksPage,
} from '../../data/talks';

const jumps = [
  ...talkCategories.map((category) => ({
    href: `#${category.id}`,
    label: category.title,
    icon: category.icon,
  })),
  { href: '#all-talks', label: 'Full list', icon: 'calendar' as const },
];
---

<BaseLayout title={talksPage.title} description={talksPage.description}>
  <PageHero
    title={talksPage.title}
    eyebrow={talksPage.eyebrow}
    highlight={talksPage.highlight}
    quote={{ text: talksPage.quote }}
  >
    <TalkHeroIntro intro={talksPage.intro} stats={talkStats} jumps={jumps} />
  </PageHero>

  <div class="py-4 sm:py-6" role="region" aria-label="Some of the stages on the list">
    <Marquee duration={50}>
      {
        talkStages.map((stage) => (
          <span class="font-display text-muted inline-flex items-center gap-4 text-2xl font-bold tracking-tight whitespace-nowrap sm:text-4xl">
            {stage}
            <span class="text-gradient text-xl sm:text-2xl" aria-hidden="true">
              ✦
            </span>
          </span>
        ))
      }
    </Marquee>
  </div>

  {
    talkCategories.map((category, index) => (
      <TalkCategorySection category={category} index={index} />
    ))
  }

  <Section id="all-talks" eyebrow="Year by year" title={talksPage.logTitle}>
    <TalkLog years={talkLog} tones={talkTagTones} />
  </Section>
</BaseLayout>
