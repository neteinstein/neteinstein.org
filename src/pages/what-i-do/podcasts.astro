---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PodcastCard from '../../components/PodcastCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { podcasts } from '../../data/podcasts';
---

<BaseLayout
  title="Podcasts"
  description="Podcasts hosted and co-hosted by Pedro Vicente — Mindera Yellow Box and O Que Arde Cura."
>
  <PageHeader
    title="Podcasts"
    lead="Tech, business and cultural conversations — and one show involving progressively hotter sauces."
  />

  {
    podcasts.length === 0 ? (
      <EmptyState source="src/data/podcasts.ts" />
    ) : (
      <div class="grid gap-4">
        {podcasts.map((podcast) => (
          <PodcastCard podcast={podcast} />
        ))}
      </div>
    )
  }
</BaseLayout>
