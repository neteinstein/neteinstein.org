---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Prose from '../../components/Prose.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import AppearanceCard from '../../components/tech/AppearanceCard.astro';
import FootprintCard from '../../components/tech/FootprintCard.astro';
import TeachingCard from '../../components/tech/TeachingCard.astro';
import PortfolioEra from '../../components/tech/PortfolioEra.astro';
import TalksCallout from '../../components/tech/TalksCallout.astro';
import * as tech from '../../data/tech';
import { useI18n } from '../../i18n';
import { getPage } from '../../i18n/content';

const { t, locale, localize } = useI18n(Astro);
const { appearances, footprints, portfolio, talksLink, teaching, techPage } = localize(tech);
const entry = await getPage('tech-engineer', locale);
const { Content } = await render(entry);
const { title, description, eyebrow, highlight } = entry.data;

const [featuredFootprint, ...otherFootprints] = footprints;
---

<BaseLayout title={title} description={description}>
  <PageHero title={title} eyebrow={eyebrow} highlight={highlight} quote={{ text: techPage.quote }}>
    <Fragment slot="actions">
      <ButtonLink href="#portfolio" trailing="arrow-down">{t('Tech Portfolio')}</ButtonLink>
      <ButtonLink href="#appeared" variant="secondary" trailing="arrow-down"
        >{t('Appearances')}</ButtonLink
      >
    </Fragment>
  </PageHero>

  <section id="persona" class="container-page py-10 sm:py-14" aria-labelledby="persona-title">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-14">
      <header class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">{t('About')}</p>
        <h2
          id="persona-title"
          class="font-display mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl"
        >
          {techPage.persona}
        </h2>
        <div class="mt-6 h-1 w-24 rounded-full bg-[image:var(--gradient-brand)]" aria-hidden="true">
        </div>
      </header>
      <div
        class="border-line bg-surface-raised rounded-3xl border p-6 shadow-[var(--shadow-sm)] sm:p-10"
        data-reveal
      >
        <Prose>
          <Content />
        </Prose>
      </div>
    </div>
  </section>

  <Section id="appeared" eyebrow={t('Media')} title={techPage.appeared}>
    <div class="grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {appearances.map((appearance) => <AppearanceCard appearance={appearance} />)}
    </div>
  </Section>

  <Section id="footprint" eyebrow={t('Online')} title={techPage.footprint}>
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]" data-reveal-stagger>
      {
        featuredFootprint && (
          <FootprintCard footprint={featuredFootprint} featured class="lg:row-span-2" />
        )
      }
      {otherFootprints.map((footprint) => <FootprintCard footprint={footprint} />)}
    </div>
  </Section>

  <Section id="teacher" eyebrow={t('Teaching')} title={techPage.teacher}>
    <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
      {teaching.map((item) => <TeachingCard teaching={item} />)}
    </div>
  </Section>

  <Section id="portfolio" eyebrow={t('Work')} title={techPage.portfolio}>
    <div class="space-y-20 sm:space-y-24">
      {portfolio.map((era) => <PortfolioEra era={era} />)}
    </div>
  </Section>

  <section class="container-page py-10 sm:py-16">
    <TalksCallout link={talksLink} />
  </section>
</BaseLayout>
