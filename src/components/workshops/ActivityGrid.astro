---
import type { WorkshopActivity } from '../../data/types';

/**
 * A few of a theme's games and stories, as cards: emoji, format, name and
 * what it is for. There is nothing on how they run, on purpose. Four cards
 * go two by two, then in one row, rather than leave one alone on a row.
 */
interface Props {
  activities: WorkshopActivity[];
}

const { activities } = Astro.props;
---

<ul
  class:list={[
    'grid gap-5 sm:grid-cols-2',
    activities.length === 4 ? 'xl:grid-cols-4' : 'lg:grid-cols-3',
  ]}
  data-reveal-stagger
>
  {activities.map((activity) => (
    <li
      class="group glow-ring border-line bg-surface-raised relative flex flex-col overflow-hidden rounded-3xl border p-6 shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] sm:p-7"
      data-spotlight
    >
      <div
        class="pointer-events-none absolute -top-20 -right-20 size-44 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--tone)_22%,transparent),transparent)]"
        aria-hidden="true"
      />
      <div class="relative flex items-start justify-between gap-3">
        <span
          class="border-line bg-surface-sunken grid size-12 shrink-0 place-items-center rounded-2xl border text-2xl transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-6"
          aria-hidden="true"
        >
          {activity.emoji}
        </span>
        <span class="text-fg rounded-full border border-[color-mix(in_oklch,var(--tone)_30%,transparent)] bg-[color-mix(in_oklch,var(--tone)_12%,transparent)] px-2.5 py-0.5 text-xs font-medium">
          {activity.format}
        </span>
      </div>
      <h4 class="font-display relative mt-5 text-xl leading-snug font-bold tracking-tight">
        {activity.name}
      </h4>
      <p class="text-muted relative mt-2 leading-relaxed text-pretty">{activity.purpose}</p>
    </li>
  ))}
</ul>
