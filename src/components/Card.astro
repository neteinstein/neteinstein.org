---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import Tag from './Tag.astro';
import { isExternal, withBase } from '../lib/url';

/**
 * The workhorse content card: optional image, eyebrow/meta line, title,
 * description, tags and inline links. With `href`, the whole card is
 * clickable (the title link is stretched over it) while `links` stay
 * independently clickable above it.
 *
 * Hover: lifts, zooms the image, lights a pointer spotlight and a rotating
 * gradient ring. All of it is decoration — nothing depends on it.
 */
interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  /** Right-aligned detail on the eyebrow row — a year, a place. */
  meta?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageFit?: 'cover' | 'contain';
  /** CSS aspect-ratio for the image frame. */
  aspect?: string;
  icon?: IconName;
  tags?: string[];
  links?: { label: string; href: string }[];
  headingLevel?: 2 | 3 | 4;
  class?: string;
}

const {
  title,
  href,
  eyebrow,
  meta,
  description,
  image,
  imageAlt = '',
  imageFit = 'cover',
  aspect = '16 / 10',
  icon,
  tags = [],
  links = [],
  headingLevel = 3,
  class: className,
} = Astro.props;

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const external = href ? isExternal(href) : false;
const resolvedHref = href && withBase(href);
---

<article
  class:list={[
    'group glow-ring border-line bg-surface-raised relative flex h-full flex-col overflow-hidden rounded-3xl border shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:shadow-[var(--shadow-lg)]',
    className,
  ]}
  data-spotlight
>
  {
    image && (
      <div
        class="border-line bg-surface-sunken relative overflow-hidden border-b"
        style={`aspect-ratio: ${aspect}`}
      >
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"
          class:list={[
            'size-full transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.06]',
            imageFit === 'cover' ? 'object-cover' : 'object-contain p-6',
          ]}
        />
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    {
      icon && !image && (
        <span class="text-accent mb-5 grid size-12 place-items-center rounded-2xl bg-[color-mix(in_oklch,var(--accent)_14%,transparent)] transition-transform duration-500 ease-[var(--ease-spring)] group-hover:scale-110 group-hover:-rotate-6">
          <Icon name={icon} class="size-6" />
        </span>
      )
    }

    {
      (eyebrow || meta) && (
        <div class="mb-2 flex items-baseline justify-between gap-3">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {meta && <p class="text-muted shrink-0 font-mono text-xs">{meta}</p>}
        </div>
      )
    }

    <Heading class="font-display text-xl leading-snug font-bold tracking-tight">
      {
        resolvedHref ? (
          <a
            href={resolvedHref}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="inline-flex items-start gap-1.5 after:absolute after:inset-0 after:z-0 after:rounded-3xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-[var(--link)]"
          >
            {title}
            <Icon
              name={external ? 'arrow-up-right' : 'arrow-right'}
              class="text-accent mt-1 size-4 shrink-0 opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100"
            />
          </a>
        ) : (
          title
        )
      }
    </Heading>

    {description && <p class="text-muted mt-2.5 text-[0.95rem] leading-relaxed">{description}</p>}

    <slot />

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))}
        </ul>
      )
    }

    {
      links.length > 0 && (
        <ul class="relative z-10 mt-auto flex flex-wrap gap-x-4 gap-y-2 pt-5">
          {links.map((link) => {
            const out = isExternal(link.href);
            return (
              <li>
                <a
                  href={withBase(link.href)}
                  target={out ? '_blank' : undefined}
                  rel={out ? 'noopener noreferrer' : undefined}
                  class="link-underline text-link inline-flex items-center gap-1 text-sm font-semibold"
                >
                  {link.label}
                  <Icon name={out ? 'arrow-up-right' : 'arrow-right'} class="size-3.5" />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</article>
