---
import type { Teaching } from '../../data/types';
import TechImageFrame from './TechImageFrame.astro';
import TechText from './TechText.astro';

/** A "Been a teacher at:" card: school logo, name, what was taught and when. */
interface Props {
  teaching: Teaching;
}

const { teaching } = Astro.props;
const { name, lines, years, image } = teaching;
const siblingHrefs = [
  name.href,
  ...lines.flat().flatMap((part) => (typeof part === 'string' ? [] : [part.href])),
];
---

<article
  class="group glow-ring border-line bg-surface-raised relative flex h-full flex-col gap-5 rounded-3xl border p-5 shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] sm:flex-row sm:p-6"
  data-spotlight
>
  <TechImageFrame
    image={image}
    siblingHrefs={siblingHrefs}
    widths={[160, 320]}
    sizes="8rem"
    class="border-line size-28 shrink-0 rounded-2xl border sm:size-32"
  />
  <div class="flex min-w-0 flex-1 flex-col">
    <h3 class="font-display text-xl leading-snug font-bold tracking-tight sm:text-2xl">
      <TechText text={[name]} linkClass="link-underline" />
    </h3>
    {
      lines.map((line) => (
        <p class="text-muted mt-2 leading-relaxed text-pretty">
          <TechText text={line} />
        </p>
      ))
    }
    <p
      class="text-accent mt-auto self-start pt-4 font-mono text-xs font-semibold tracking-[0.14em] uppercase"
    >
      {years}
    </p>
  </div>
</article>
