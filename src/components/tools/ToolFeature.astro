---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import DocStack from './DocStack.astro';
import type { LinkRef } from '../../data/types';
import { isExternal } from '../../lib/url';
import { useI18n } from '../../i18n';

/**
 * A large tile on the /tools index: a visual (a screenshot, or a drawn stack
 * of pages for a document), a gradient ordinal, the tool's title — whose link
 * is stretched over the whole tile — and its own outbound links, which stay
 * independently clickable above the stretched link.
 */
interface Props {
  /** 1-based position, shown as a large "01". */
  index: number;
  title: string;
  href: string;
  description?: string;
  links?: LinkRef[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Used when there is no image: labels the drawn stack of pages. */
  fileName?: string;
}

const { index, title, href, description, links = [], image, imageAlt = '', fileName } = Astro.props;

const ordinal = String(index).padStart(2, '0');

const { localHref } = useI18n(Astro);
---

<article
  class="group glow-ring border-line bg-surface-raised relative flex h-full flex-col overflow-hidden rounded-[2rem] border shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:shadow-[var(--shadow-lg)]"
  data-spotlight
>
  <div class="border-line bg-surface-sunken relative aspect-[16/10] overflow-hidden border-b">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 720, 960, 1270]}
          sizes="(min-width: 1024px) 36rem, 100vw"
          class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
        />
      ) : (
        <div class="absolute inset-0 grid place-items-center overflow-hidden">
          <div
            class="pointer-events-none absolute -top-1/3 -left-1/4 size-[80%] rounded-full bg-[radial-gradient(closest-side,var(--glow-c),transparent)]"
            aria-hidden="true"
          />
          <div
            class="pointer-events-none absolute -right-1/4 -bottom-1/2 size-[90%] rounded-full bg-[radial-gradient(closest-side,var(--glow-b),transparent)]"
            aria-hidden="true"
          />
          <div class="dot-grid absolute inset-0 opacity-70" aria-hidden="true" />
          {fileName && (
            <div class="relative w-[34%] translate-y-[6%] text-[clamp(0.5rem,1.3vw,0.8rem)]">
              <DocStack name={fileName} />
            </div>
          )}
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 class="font-display text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
        <a
          href={localHref(href)}
          class="after:absolute after:inset-0 after:z-0 after:rounded-[2rem] focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-[var(--link)]"
        >
          {title}
        </a>
      </h2>
      <span
        class="text-gradient font-display shrink-0 text-5xl leading-none font-extrabold tracking-tighter sm:text-6xl"
        aria-hidden="true"
      >
        {ordinal}
      </span>
    </div>

    {
      description && (
        <p class="text-muted mt-3 text-lg leading-relaxed text-pretty">{description}</p>
      )
    }

    <div class="mt-auto flex items-end justify-between gap-4 pt-7">
      {
        links.length > 0 && (
          <ul class="relative z-10 flex min-w-0 flex-wrap gap-x-4 gap-y-2">
            {links.map((link) => {
              const external = isExternal(link.href);
              return (
                <li class="min-w-0">
                  <a
                    href={localHref(link.href)}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    class="link-underline text-link inline-flex items-center gap-1.5 font-mono text-sm font-semibold break-all"
                  >
                    {link.label}
                    <Icon
                      name={external ? 'arrow-up-right' : 'arrow-right'}
                      class="size-3.5 shrink-0"
                    />
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
      <span
        class="border-line-strong text-fg group-hover:text-on-accent ml-auto grid size-12 shrink-0 place-items-center rounded-full border transition-all duration-500 ease-[var(--ease-spring)] group-hover:border-transparent group-hover:bg-[image:var(--gradient-brand)]"
        aria-hidden="true"
      >
        <Icon
          name="arrow-right"
          class="size-5 transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-45"
        />
      </span>
    </div>
  </div>
</article>
