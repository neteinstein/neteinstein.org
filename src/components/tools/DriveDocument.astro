---
import ButtonLink from '../ButtonLink.astro';
import Embed from '../Embed.astro';
import DocStack from './DocStack.astro';
import type { ToolsDriveDocument } from '../../data/types';

/**
 * A Google Drive document: Drive's own viewer, beside a sticky panel that
 * names the file and offers it in Drive or as a download. On small screens the
 * panel (minus the drawn page stack) sits above the viewer.
 */
interface Props {
  doc: ToolsDriveDocument;
  /** Heading level for the file name. */
  headingLevel?: 2 | 3;
}

const { doc, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<div
  class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,44rem)] lg:gap-14 xl:gap-20"
>
  <aside class="lg:sticky lg:top-28" data-reveal>
    <div class="group mb-12 hidden max-w-[17rem] lg:block">
      <DocStack name={doc.name} class="text-[0.95rem]" />
    </div>
    <p class="eyebrow">Google Drive</p>
    <Heading
      class="font-display mt-2 text-3xl leading-tight font-bold tracking-tight break-words sm:text-4xl"
    >
      {doc.name}
    </Heading>
    <div class="mt-7 flex flex-wrap gap-3">
      <ButtonLink href={doc.openUrl}>Open in Google Drive</ButtonLink>
      <ButtonLink href={doc.downloadUrl} variant="secondary" icon="download" trailing={false}>
        Download
      </ButtonLink>
    </div>
  </aside>

  <div data-reveal>
    <Embed
      src={doc.previewUrl}
      title={doc.name}
      aspect="4 / 5"
      fallbackHref={doc.openUrl}
      fallbackLabel={`Open ${doc.name} in Google Drive`}
    />
  </div>
</div>
