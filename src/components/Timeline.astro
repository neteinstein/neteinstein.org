---
import { isExternal, withBase } from '../lib/url';
import Tag from './Tag.astro';

/**
 * Vertical timeline. The rail is a gradient that fills as the list scrolls
 * through the viewport (scroll-driven where supported, static elsewhere);
 * each entry reveals as it arrives.
 */
export interface TimelineEntry {
  /** Display date — "2024", "Dec 2024", "2016 – 2019". */
  when: string;
  title: string;
  subtitle?: string;
  description?: string;
  href?: string;
  tags?: string[];
}

interface Props {
  items: TimelineEntry[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['timeline relative ml-3 space-y-8 border-l-0 pl-8 sm:ml-4 sm:pl-10', className]}>
  <span class="timeline-rail absolute top-2 bottom-2 left-0 w-[2px] rounded-full" aria-hidden="true"
  ></span>
  {
    items.map((item) => {
      const external = item.href ? isExternal(item.href) : false;
      return (
        <li class="relative" data-reveal="left">
          <span
            class="border-accent bg-surface absolute top-1.5 -left-8 grid size-4 -translate-x-[7px] place-items-center rounded-full border-2 sm:-left-10"
            aria-hidden="true"
          >
            <span class="bg-accent-2 size-1.5 rounded-full" />
          </span>
          <p class="text-accent font-mono text-xs font-semibold tracking-wider uppercase">
            {item.when}
          </p>
          <h3 class="font-display mt-1 text-lg leading-snug font-bold">
            {item.href ? (
              <a
                href={withBase(item.href)}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
                class="link-underline"
              >
                {item.title}
                {external && <span aria-hidden="true"> ↗</span>}
              </a>
            ) : (
              item.title
            )}
          </h3>
          {item.subtitle && <p class="text-fg/80 mt-0.5 text-sm font-medium">{item.subtitle}</p>}
          {item.description && <p class="text-muted mt-2 text-[0.95rem]">{item.description}</p>}
          {item.tags && item.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <li>
                  <Tag>{tag}</Tag>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .timeline-rail {
    background: var(--border-strong);
  }
  @supports (animation-timeline: view()) {
    :global(.motion-ok) .timeline-rail {
      background:
        linear-gradient(to bottom, var(--accent), var(--accent-2) 50%, var(--accent-3)) top / 100%
          0% no-repeat,
        var(--border-strong);
      animation: rail-fill linear both;
      animation-timeline: view();
      animation-range: entry 20% exit 40%;
    }
  }
  @keyframes rail-fill {
    to {
      background-size:
        100% 100%,
        auto;
    }
  }
</style>
