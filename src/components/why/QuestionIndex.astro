---
import { getEntry, render } from 'astro:content';

/**
 * Jump links to every question on a prose page, built from the `##` headings
 * of its MDX entry — so the list can never drift from the copy.
 */
interface Props {
  /** Filename (without extension) under `src/content/pages/`. */
  slug: string;
  label: string;
}

const { slug, label } = Astro.props;

const entry = await getEntry('pages', slug);
if (!entry) {
  throw new Error(`Missing content entry: src/content/pages/${slug}.mdx`);
}
const { headings } = await render(entry);
const questions = headings.filter((heading) => heading.depth === 2);
---

<nav aria-label={label} class="w-full">
  <p class="text-muted font-mono text-[0.7rem] font-semibold tracking-[0.14em] uppercase">
    {label}
  </p>
  <ul class="mt-3 flex flex-wrap gap-2">
    {
      questions.map((question, index) => (
        <li>
          <a
            href={`#${question.slug}`}
            class="group glass border-line text-fg hover:border-accent inline-flex items-center gap-2 rounded-full border py-1.5 pr-3.5 pl-2 text-sm font-medium shadow-[var(--shadow-sm)] transition-[translate,border-color,box-shadow] duration-300 ease-[var(--ease-spring)] hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
          >
            <span
              class="bg-surface-sunken text-accent group-hover:text-on-accent grid size-6 place-items-center rounded-full font-mono text-[0.65rem] font-semibold transition-colors group-hover:bg-[image:var(--gradient-brand)]"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            {question.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
