---
import type { KidsPlace } from '../data/types';

interface Props {
  place: KidsPlace;
}

const { place } = Astro.props;

const SETTING_LABELS: Record<KidsPlace['setting'], string> = {
  indoor: 'Indoor',
  outdoor: 'Outdoor',
  both: 'Indoor & outdoor',
};

const children =
  place.maxChildren && place.maxChildren !== place.minChildren
    ? `${place.minChildren}-${place.maxChildren}`
    : `${place.minChildren}+`;
---

<article class="rounded-lg border border-[var(--border)] bg-[var(--surface-raised)] p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-lg font-semibold text-balance">{place.name}</h3>
    <span class="shrink-0 text-sm text-[var(--text-muted)]">{place.area}</span>
  </div>

  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-4">
    <div>
      <dt class="text-xs text-[var(--text-muted)]">Setting</dt>
      <dd>{SETTING_LABELS[place.setting]}</dd>
    </div>
    <div>
      <dt class="text-xs text-[var(--text-muted)]">
        Cost per child <a href="#cost-note" class="text-[var(--link)]">*</a>
      </dt>
      <dd>
        {place.costMin.toFixed(2).replace('.00', '')}€ - {
          place.costMax.toFixed(2).replace('.00', '')
        }€
      </dd>
    </div>
    <div>
      <dt class="text-xs text-[var(--text-muted)]">Children</dt>
      <dd>{children}</dd>
    </div>
    {
      place.ages && (
        <div>
          <dt class="text-xs text-[var(--text-muted)]">Ages</dt>
          <dd>{place.ages}</dd>
        </div>
      )
    }
    {
      place.duration && (
        <div>
          <dt class="text-xs text-[var(--text-muted)]">Duration</dt>
          <dd>{place.duration}</dd>
        </div>
      )
    }
  </dl>

  {
    place.schedules && place.schedules.length > 0 && (
      <div class="mt-3 text-sm">
        <p class="text-xs text-[var(--text-muted)]">Schedules</p>
        <ul class="mt-0.5">
          {place.schedules.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    place.includes && place.includes.length > 0 && (
      <div class="mt-3 text-sm">
        <p class="text-xs text-[var(--text-muted)]">Includes</p>
        <ul class="mt-0.5 list-inside list-disc">
          {place.includes.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }

  {place.notes && <p class="mt-3 text-sm text-[var(--text-muted)]">{place.notes}</p>}

  <div class="mt-4 flex flex-wrap gap-3">
    {
      place.url && (
        <a
          href={place.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--link)] underline underline-offset-2"
        >
          Website
        </a>
      )
    }
    {
      place.mapUrl && (
        <a
          href={place.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-[var(--link)] underline underline-offset-2"
        >
          Google Maps
        </a>
      )
    }
  </div>
</article>
