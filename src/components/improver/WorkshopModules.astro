---
import type { ImproverModuleGroup } from '../../data/types';

/**
 * The workshop module groups as three cards side by side (stacked below
 * `lg`). Each module is an emoji tile plus its label.
 */
interface Props {
  groups: ImproverModuleGroup[];
}

const { groups } = Astro.props;
const tones = ['--accent', '--accent-2', '--accent-4'];
---

<div class="grid gap-5 lg:grid-cols-3" data-reveal-stagger>
  {
    groups.map((group, index) => (
      <article
        class="group glow-ring border-line bg-surface-raised relative overflow-hidden rounded-3xl border p-6 shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] sm:p-7"
        style={`--tone: var(${tones[index % tones.length]})`}
        data-spotlight
      >
        <div
          class="pointer-events-none absolute -top-20 -right-20 size-48 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--tone)_28%,transparent),transparent)]"
          aria-hidden="true"
        />
        <h3 class="font-display relative flex items-center gap-3 text-xl font-bold tracking-tight sm:text-2xl">
          <span
            class="h-6 w-1.5 rounded-full bg-[color-mix(in_oklch,var(--tone)_85%,transparent)]"
            aria-hidden="true"
          />
          {group.title}
        </h3>
        <ul class="relative mt-5 space-y-2.5">
          {group.items.map((item) => (
            <li class="flex items-center gap-3.5">
              <span
                class="border-line bg-surface-sunken grid size-11 shrink-0 place-items-center rounded-xl border text-xl transition-transform duration-500 ease-[var(--ease-spring)] group-hover:-rotate-6"
                aria-hidden="true"
              >
                {item.emoji}
              </span>
              <span class="leading-snug font-medium">{item.label}</span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
