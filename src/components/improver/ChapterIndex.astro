---
import type { ImproverChapter } from '../../data/types';
import Icon from '../Icon.astro';

/**
 * In-page contents for /what-i-do/improver, rendered under the hero quote:
 * one numbered pill per chapter, pointing at its fragment id.
 */
interface Props {
  chapters: ImproverChapter[];
}

const { chapters } = Astro.props;
---

<nav aria-label="On this page" class="mt-10" data-enter style="--delay: 600">
  <ol class="flex flex-wrap gap-2.5">
    {
      chapters.map((chapter, index) => (
        <li>
          <a
            href={`#${chapter.id}`}
            class="group glass border-line hover:border-accent inline-flex items-center gap-2.5 rounded-full border py-1.5 pr-4 pl-1.5 text-sm font-semibold shadow-[var(--shadow-sm)] transition-[translate,border-color,box-shadow] duration-300 ease-[var(--ease-spring)] hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
          >
            <span
              class="text-on-accent grid size-7 place-items-center rounded-full bg-[image:var(--gradient-brand)] font-mono text-[0.7rem] font-bold"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            {chapter.title}
            <Icon
              name="arrow-down"
              class="text-muted size-3.5 transition-transform duration-300 group-hover:translate-y-0.5"
            />
          </a>
        </li>
      ))
    }
  </ol>
</nav>
