---
import type { ImproverWorkshopForm } from '../../data/types';
import { useI18n } from '../../i18n';

/**
 * Native-styled contact form for the underlying Google Form (same
 * spreadsheet the original embed wrote to), instead of embedding the Google
 * Forms iframe.
 *
 * The markup only knows the Google Form's `viewform` page: with JS off,
 * submitting opens it in a new tab pre-filled with the answers, and the
 * visitor sends it from there. The inline `<script>` is what posts to
 * `formResponse` (via a hidden iframe), and only after two bot checks pass:
 * a honeypot field people never see, and a minimum time on the page. Bots
 * that fail them get the same success message and nothing is sent, so the
 * scraped HTML never carries the endpoint that writes to the spreadsheet.
 */
interface Props {
  form: ImproverWorkshopForm;
}

const { form } = Astro.props;
const { t } = useI18n(Astro);
const frameName = 'workshop-form-target';
const honeypotClass =
  'pointer-events-none absolute -left-[9999px] size-px overflow-hidden opacity-0';
---

<div class="border-line bg-surface-sunken rounded-3xl border p-6 shadow-[var(--shadow-md)] sm:p-8">
  <form
    action={form.fallbackHref}
    method="GET"
    target="_blank"
    class="relative grid gap-4 sm:grid-cols-2"
    data-workshop-form
    data-endpoint={form.action}
    data-frame={frameName}
    data-success-message={form.successMessage}
  >
    <label class={honeypotClass} aria-hidden="true">
      {t('Leave this field empty')}
      <input type="text" tabindex="-1" autocomplete="off" data-workshop-honeypot />
    </label>

    {form.fields.map((field) => {
      const isWide = field.type === 'textarea';
      const inputClass =
        'border-line-strong bg-surface-raised text-fg placeholder:text-muted w-full rounded-2xl border px-4 py-2.5 text-base transition-shadow focus:shadow-[0_0_0_4px_color-mix(in_oklch,var(--accent)_18%,transparent)] focus:outline-none sm:text-sm';
      return (
        <label
          class:list={['flex flex-col gap-1.5 text-sm font-medium', isWide && 'sm:col-span-2']}
        >
          <span>
            {field.label}
            {field.required && (
              <span class="text-accent-2" aria-hidden="true">
                {' '}
                *
              </span>
            )}
          </span>
          {field.type === 'textarea' ? (
            <textarea name={field.entry} required={field.required} rows={4} class={inputClass} />
          ) : (
            <input
              type={field.type === 'email' ? 'email' : field.type === 'tel' ? 'tel' : 'text'}
              name={field.entry}
              required={field.required}
              class={inputClass}
            />
          )}
        </label>
      );
    })}

    <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
      <button
        type="submit"
        class="text-on-accent rounded-full bg-[image:var(--gradient-brand)] bg-[length:200%_auto] bg-left px-6 py-2.5 text-sm font-semibold shadow-[0_8px_24px_-8px_color-mix(in_oklch,var(--accent)_70%,transparent)] transition-all duration-300 ease-[var(--ease-spring)] hover:-translate-y-0.5 hover:bg-right active:scale-[0.97]"
      >
        {form.submitLabel}
      </button>
      <p class="text-muted text-sm" data-workshop-form-status role="status" aria-live="polite"></p>
    </div>
  </form>

  <p class="text-muted mt-4 text-sm">
    <a
      href={form.fallbackHref}
      target="_blank"
      rel="noopener noreferrer"
      class="link-underline text-link font-medium"
    >
      {form.fallbackLabel} ↗
    </a>
  </p>

  <iframe name={frameName} hidden title={t('Form submission target')}></iframe>
</div>

<script>
  // No person reads the form and fills it in faster than this.
  const MIN_FILL_MS = 3000;
  const loadedAt = performance.now();

  const forms = document.querySelectorAll<HTMLFormElement>('[data-workshop-form]');
  forms.forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('[data-workshop-form-status]');
    const honeypot = form.querySelector<HTMLInputElement>('[data-workshop-honeypot]');
    const { endpoint, frame, successMessage = '' } = form.dataset;
    if (!endpoint || !frame) return;

    form.addEventListener('submit', (event) => {
      const looksLikeBot = Boolean(honeypot?.value) || performance.now() - loadedAt < MIN_FILL_MS;
      if (looksLikeBot) {
        event.preventDefault();
      } else {
        form.action = endpoint;
        form.method = 'POST';
        form.target = frame;
      }
      window.setTimeout(() => {
        if (status) status.textContent = successMessage;
        form.reset();
      }, 400);
    });
  });
</script>
