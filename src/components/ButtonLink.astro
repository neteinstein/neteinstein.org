---
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import { isExternal, withBase } from '../lib/url';

/**
 * A link styled as a button. `primary` is the gradient pill with a light
 * sweep on hover; `secondary` a frosted outline; `ghost` text-only.
 * External hrefs open in a new tab and get the ↗ glyph automatically.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  icon?: IconName;
  /** Replace the automatic trailing arrow. `false` removes it. */
  trailing?: IconName | false;
  download?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  trailing,
  download = false,
  class: className,
} = Astro.props;

const external = isExternal(href);
const trailingIcon =
  trailing === false ? undefined : (trailing ?? (external ? 'arrow-up-right' : 'arrow-right'));
---

<a
  href={withBase(href)}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download || undefined}
  class:list={[
    'group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-semibold whitespace-nowrap transition-all duration-300 ease-[var(--ease-spring)] active:scale-[0.97]',
    size === 'lg' ? 'px-7 py-3.5 text-base' : 'px-5 py-2.5 text-sm',
    variant === 'primary' &&
      'text-on-accent bg-[image:var(--gradient-brand)] bg-[length:200%_auto] bg-left shadow-[0_8px_24px_-8px_color-mix(in_oklch,var(--accent)_70%,transparent)] hover:-translate-y-0.5 hover:bg-right hover:shadow-[0_14px_32px_-10px_color-mix(in_oklch,var(--accent-2)_80%,transparent)]',
    variant === 'secondary' &&
      'glass border-line-strong text-fg hover:border-accent border hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]',
    variant === 'ghost' && 'text-link hover:bg-[color-mix(in_oklch,var(--accent)_10%,transparent)]',
    className,
  ]}
>
  {
    variant === 'primary' && (
      <span
        class="pointer-events-none absolute inset-y-0 -left-1/2 w-1/3 -skew-x-12 bg-white/35 opacity-0 transition-all duration-700 ease-out group-hover:left-[120%] group-hover:opacity-100"
        aria-hidden="true"
      />
    )
  }
  {icon && <Icon name={icon} class="size-[1.1em]" />}
  <span class="relative"><slot /></span>
  {
    trailingIcon && (
      <Icon
        name={trailingIcon}
        class="relative size-[1.05em] transition-transform duration-300 group-hover:translate-x-0.5"
      />
    )
  }
</a>
