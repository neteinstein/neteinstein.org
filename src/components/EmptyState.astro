---
/**
 * Shown where a list has no entries yet because the content has not been
 * migrated from the Google Sites original. Deliberately explicit rather than
 * silently rendering an empty page.
 */
interface Props {
  source: string;
}

const { source } = Astro.props;
---

<p class="rounded-lg border border-dashed border-[var(--border)] p-6 text-[var(--text-muted)]">
  This list has not been migrated from the original site yet — see <code>{source}</code>.
</p>
