---
interface Props {
  title: string;
  lead?: string;
  updated?: Date;
}

const { title, lead, updated } = Astro.props;
---

<div class="mb-10 max-w-3xl">
  <h1 class="font-display text-4xl font-bold tracking-tight text-balance sm:text-5xl">
    {title}
  </h1>
  {lead && <p class="mt-4 text-lg text-pretty text-[var(--text-muted)]">{lead}</p>}
  {
    updated && (
      <p class="mt-3 text-sm text-[var(--text-muted)]">
        Last updated{' '}
        <time datetime={updated.toISOString()}>
          {updated.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' })}
        </time>
      </p>
    )
  }
</div>
