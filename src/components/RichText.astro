---
import type { RichText } from '../data/types';
import { isExternal, withBase } from '../lib/url';

/** Renders a `RichText` array — plain strings with inline links — from a data file. */
interface Props {
  text: RichText;
  /** Extra classes for the inline links. */
  linkClass?: string;
}

const { text, linkClass = 'font-semibold text-link link-underline' } = Astro.props;
---

{
  text.map((part) =>
    typeof part === 'string' ? (
      part
    ) : (
      <a
        href={withBase(part.href)}
        target={isExternal(part.href) ? '_blank' : undefined}
        rel={isExternal(part.href) ? 'noopener noreferrer' : undefined}
        class:list={['relative z-10', linkClass]}
      >
        {part.label}
      </a>
    ),
  )
}
