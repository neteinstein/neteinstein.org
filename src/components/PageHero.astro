---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import SplitWords from './SplitWords.astro';
import Icon from './Icon.astro';
import { useI18n } from '../i18n';

/**
 * The top of every inner page: eyebrow, word-by-word headline, lead and an
 * optional image (the Google Sites original opened most pages with a banner
 * photo and a quote — both have a slot here), a set of photos the frame slowly
 * cross-fades through, or a short muted, looping video in the same floating
 * frame, with pause and sound buttons.
 *
 * Extra calls to action go in the `actions` slot; anything else in the
 * default slot renders under the lead.
 */
interface Props {
  title: string;
  eyebrow?: string;
  /** Words in the title painted with the brand gradient. */
  highlight?: string[];
  lead?: string;
  quote?: { text: string; author?: string };
  image?: ImageMetadata;
  imageAlt?: string;
  /** Takes `image`'s place: the frame cross-fades through these, the first showing with JS off or reduced motion. */
  images?: { image: ImageMetadata; alt: string }[];
  /** `cover` crops photos to the frame; `contain` suits logos and cut-outs. */
  imageFit?: 'cover' | 'contain';
  /** Takes the image's place. `sources` are URLs, best first; the poster shows until it plays. */
  video?: { sources: { src: string; type: string }[]; poster: ImageMetadata; label: string };
}

const {
  title,
  eyebrow,
  highlight = [],
  lead,
  quote,
  image,
  imageAlt = '',
  images,
  imageFit = 'cover',
  video,
} = Astro.props;

const { t } = useI18n(Astro);
const poster = video && (await getImage({ src: video.poster, width: 1280, format: 'webp' }));
const photos = images ?? (image ? [{ image, alt: imageAlt }] : []);
const media = photos.length > 0 || video;
---

<section class="relative isolate overflow-hidden">
  <div
    class="dot-grid absolute inset-x-0 top-0 -z-10 h-[34rem] opacity-70"
    aria-hidden="true"
  ></div>

  <div
    class:list={[
      'container-page grid items-center gap-10 pt-12 pb-10 sm:pt-16 sm:pb-14',
      media && 'lg:grid-cols-[1.15fr_1fr] lg:gap-14',
    ]}
  >
    <div class="max-w-3xl">
      {eyebrow && (
        <p class="eyebrow inline-flex items-center gap-2" data-enter>
          <span class="bg-accent-2 inline-block size-1.5 animate-pulse rounded-full" />
          {eyebrow}
        </p>
      )}
      <h1
        class="font-display mt-4 text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.02] font-extrabold tracking-[-0.035em]"
        aria-label={title}
      >
        <SplitWords text={title} highlight={highlight} />
      </h1>
      {lead && (
        <p
          class="text-muted mt-6 max-w-2xl text-lg text-pretty sm:text-xl"
          data-enter
          style="--delay: 350"
        >
          {lead}
        </p>
      )}
      {quote && (
        <figure class="relative mt-8 max-w-2xl pl-12" data-enter style="--delay: 450">
          <Icon name="quote" class="text-accent-2/70 absolute top-0 left-0 size-8" fill />
          <blockquote class="font-display text-xl leading-snug font-medium text-pretty sm:text-2xl">
            {quote.text}
          </blockquote>
          {quote.author && (
            <figcaption class="text-muted mt-3 font-mono text-sm">— {quote.author}</figcaption>
          )}
        </figure>
      )}
      <slot />
      {Astro.slots.has('actions') && (
        <div class="mt-8 flex flex-wrap gap-3" data-enter style="--delay: 550">
          <slot name="actions" />
        </div>
      )}
    </div>

    {photos.length > 0 && (
      <div class="relative mx-auto w-full max-w-xl" data-enter style="--delay: 250">
        <div
          class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-[image:var(--gradient-brand)] opacity-25 blur-3xl"
          aria-hidden="true"
        />
        <div class="animate-float">
          <div
            class="glow-ring border-line bg-surface-raised rotate-[1.5deg] rounded-[2rem] border p-2 shadow-[var(--shadow-lg)] transition-transform duration-700 ease-[var(--ease-spring)] [--angle:0deg] hover:rotate-0"
            data-hero-photos={photos.length > 1 ? '' : undefined}
          >
            <div class="relative aspect-[4/3] w-full overflow-hidden rounded-[1.6rem]">
              {photos.map((photo, index) => (
                <Image
                  src={photo.image}
                  alt={photo.alt}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 36rem, 100vw"
                  class:list={[
                    'absolute inset-0 size-full transition-opacity duration-1000 ease-[var(--ease-out-expo)]',
                    imageFit === 'cover' ? 'object-cover' : 'object-contain p-4',
                    index > 0 && 'opacity-0',
                  ]}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  aria-hidden={index > 0 ? 'true' : undefined}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    )}

    {video && poster && (
      <div class="relative mx-auto w-full max-w-xl" data-enter style="--delay: 250">
        <div
          class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-[image:var(--gradient-brand)] opacity-25 blur-3xl"
          aria-hidden="true"
        />
        <div class="animate-float">
          <div
            data-hero-video
            class="group/video glow-ring border-line bg-surface-raised relative rotate-[1.5deg] rounded-[2rem] border p-2 shadow-[var(--shadow-lg)] transition-transform duration-700 ease-[var(--ease-spring)] [--angle:0deg] hover:rotate-0"
          >
            {/* Autoplays muted, as browsers allow; the script pauses it under reduced motion. */}
            <video
              poster={poster.src}
              width="1280"
              height="720"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={video.label}
              class="aspect-video w-full rounded-[1.6rem] object-cover"
            >
              {video.sources.map((source) => (
                <source src={source.src} type={source.type} />
              ))}
            </video>
            <div class="absolute right-4 bottom-4 flex gap-2" data-video-controls hidden>
              <button
                type="button"
                data-video-play
                aria-pressed="false"
                data-pause-label={t('Pause video')}
                data-play-label={t('Play video')}
                aria-label={t('Pause video')}
                class="glass text-fg border-line hover:border-accent grid size-10 place-items-center rounded-full border transition-colors"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path data-icon-pause d="M7 5h3v14H7zM14 5h3v14h-3z" />
                  <path data-icon-play d="M8 5v14l11-7z" class="hidden" />
                </svg>
              </button>
              <button
                type="button"
                data-video-sound
                aria-pressed="false"
                aria-label={t('Sound')}
                class="glass text-fg border-line hover:border-accent grid size-10 place-items-center rounded-full border transition-colors"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M11 5 6 9H2v6h4l5 4z" />
                  <path data-icon-muted d="m22 9-6 6M16 9l6 6" />
                  <path
                    data-icon-sound
                    d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"
                    class="hidden"
                  />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  // The hero's photo set: slowly cross-fade through it. The first photo is
  // the only one visible with JS off, and the fade stays off under reduced
  // motion, so this is pure enhancement.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const frame of document.querySelectorAll<HTMLElement>('[data-hero-photos]')) {
      const photos = [...frame.querySelectorAll('img')];
      if (photos.length < 2) continue;
      let current = 0;
      setInterval(() => {
        if (document.hidden) return;
        const next = (current + 1) % photos.length;
        const leaving = photos[current];
        const entering = photos[next];
        if (!leaving || !entering) return;
        leaving.classList.add('opacity-0');
        leaving.setAttribute('aria-hidden', 'true');
        entering.classList.remove('opacity-0');
        entering.removeAttribute('aria-hidden');
        current = next;
      }, 5000);
    }
  }

  // The hero video's buttons: they only appear with JS, since they need it.
  for (const frame of document.querySelectorAll<HTMLElement>('[data-hero-video]')) {
    const video = frame.querySelector('video');
    const controls = frame.querySelector<HTMLElement>('[data-video-controls]');
    const play = frame.querySelector<HTMLButtonElement>('[data-video-play]');
    const sound = frame.querySelector<HTMLButtonElement>('[data-video-sound]');
    if (!video || !controls || !play || !sound) continue;

    const sync = () => {
      const paused = video.paused;
      play.setAttribute('aria-pressed', String(paused));
      play.setAttribute(
        'aria-label',
        (paused ? play.dataset.playLabel : play.dataset.pauseLabel) ?? '',
      );
      play.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      play.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
      sound.setAttribute('aria-pressed', String(!video.muted));
      sound.querySelector('[data-icon-muted]')?.classList.toggle('hidden', !video.muted);
      sound.querySelector('[data-icon-sound]')?.classList.toggle('hidden', video.muted);
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      video.currentTime = 0;
    }
    play.addEventListener('click', () => (video.paused ? void video.play() : video.pause()));
    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) void video.play();
    });
    for (const event of ['play', 'pause', 'volumechange']) video.addEventListener(event, sync);
    controls.hidden = false;
    sync();
  }
</script>
