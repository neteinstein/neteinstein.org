---
import type { Talk } from '../data/types';

interface Props {
  talk: Talk;
}

const { talk } = Astro.props;

const TYPE_LABELS: Record<Talk['type'], string> = {
  talk: 'Talk',
  workshop: 'Workshop',
  panel: 'Panel',
};

const links = [
  talk.slidesUrl && { label: 'Slides', href: talk.slidesUrl },
  talk.videoUrl && { label: 'Video', href: talk.videoUrl },
  talk.eventUrl && { label: 'Event', href: talk.eventUrl },
].filter(Boolean) as { label: string; href: string }[];
---

<article class="rounded-lg border border-[var(--border)] bg-[var(--surface-raised)] p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-lg font-semibold text-balance">{talk.title}</h3>
    <span class="shrink-0 text-sm text-[var(--text-muted)]">{talk.date}</span>
  </div>

  <p class="mt-1 text-sm text-[var(--text-muted)]">
    {TYPE_LABELS[talk.type]} · {talk.event}{talk.location && ` · ${talk.location}`}
  </p>

  {talk.description && <p class="mt-3 text-sm">{talk.description}</p>}

  {
    links.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-3">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-[var(--link)] underline underline-offset-2"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
