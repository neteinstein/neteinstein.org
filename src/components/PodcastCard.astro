---
import type { Podcast } from '../data/types';

interface Props {
  podcast: Podcast;
}

const { podcast } = Astro.props;
---

<article class="rounded-lg border border-[var(--border)] bg-[var(--surface-raised)] p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="font-display text-lg font-semibold">
      {
        podcast.url ? (
          <a
            href={podcast.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--link)]"
          >
            {podcast.title}
          </a>
        ) : (
          podcast.title
        )
      }
    </h3>
    <span class="shrink-0 text-xs tracking-wide text-[var(--text-muted)] uppercase">
      {podcast.language === 'pt' ? 'Português' : 'English'}
    </span>
  </div>

  {podcast.date && <p class="mt-1 text-sm text-[var(--text-muted)]">{podcast.date}</p>}
  {podcast.description && <p class="mt-3 text-sm leading-relaxed">{podcast.description}</p>}
</article>
