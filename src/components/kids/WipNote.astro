---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { KidsPhoto } from '../../data/types';

/**
 * What follows the table on the original: the "work in progress" sign, then
 * the cost footnote (the default slot). The sign becomes a taped-on sticker;
 * the note is the target of the table's `*` marker and lights up when jumped to.
 */
interface Props {
  sign: KidsPhoto;
  /** Id of the note, linked from the footnote marker in the table. */
  noteId: string;
}

const { sign, noteId } = Astro.props;
---

<div class="grid items-center gap-10 sm:grid-cols-[auto_1fr] sm:gap-12">
  <div class="mx-auto w-full max-w-[15rem] pt-3 sm:mx-0 sm:w-60" data-reveal="scale">
    <div class="animate-float">
      <div
        class="border-line bg-surface-raised relative -rotate-3 rounded-2xl border p-2 shadow-[var(--shadow-lg)] transition-transform duration-700 ease-[var(--ease-spring)] hover:rotate-0"
      >
        <span
          class="absolute -top-3 left-1/2 h-6 w-28 -translate-x-1/2 rotate-2 rounded-sm bg-[repeating-linear-gradient(-45deg,var(--accent-3)_0_9px,var(--text)_9px_18px)] opacity-90 shadow-[var(--shadow-sm)]"
          aria-hidden="true"></span>
        <Image
          src={sign.image}
          alt={sign.alt}
          widths={[259]}
          sizes="15rem"
          class="w-full rounded-xl"
        />
      </div>
    </div>
  </div>

  <div
    id={noteId}
    class="border-line-strong target:border-accent relative scroll-mt-28 rounded-3xl border border-dashed p-6 transition-colors duration-500 target:bg-[color-mix(in_oklch,var(--accent)_8%,transparent)] sm:p-8"
    data-reveal
  >
    <span
      class="text-accent-3 mb-4 grid size-11 place-items-center rounded-2xl bg-[color-mix(in_oklch,var(--accent-3)_16%,transparent)]"
      aria-hidden="true"
    >
      <Icon name="calendar" class="size-5" />
    </span>
    <div class="text-muted text-lg leading-relaxed text-pretty [&_em]:italic [&_p]:m-0">
      <slot />
    </div>
  </div>
</div>
