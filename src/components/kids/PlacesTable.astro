---
import Icon from '../Icon.astro';
import Tag from '../Tag.astro';
import ColumnGlyph from './ColumnGlyph.astro';
import KidsGlyph from './KidsGlyph.astro';
import PlaceNotes from './PlaceNotes.astro';
import type { KidsColumn, KidsColumnKey, KidsPlace } from '../../data/types';
import { isExternal } from '../../lib/url';
import { useI18n } from '../../i18n';

/**
 * The "places for kids" table. From `xl` up it is a real `<table>` (column
 * headers, a row header per place); below that the same rows become stacked
 * cards whose cells are labelled with the column names. Only one of the two is
 * ever displayed, so assistive tech never meets the content twice.
 */
interface Props {
  places: KidsPlace[];
  columns: KidsColumn[];
  /** Accessible name of the table. */
  caption: string;
  /** Id of the note the footnote marker (`*`) links to. */
  noteId: string;
}

const { places, columns, caption, noteId } = Astro.props;
const { t, localHref } = useI18n(Astro);

/** Plain-text cells; `where`, `name` and `notes` are rendered by hand. */
type TextKey = Exclude<KidsColumnKey, 'where' | 'name' | 'notes'>;
const isText = (key: KidsColumnKey): key is TextKey =>
  key !== 'where' && key !== 'name' && key !== 'notes';

const tiles = columns.filter((column) => isText(column.key));
const notesColumn = columns.find((column) => column.key === 'notes');
const linkAttrs = (href: string) =>
  isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{/* ───────────── Wide screens: a real table ───────────── */}
<div
  class="glow-ring border-line bg-surface-raised relative hidden overflow-hidden rounded-[2rem] border shadow-[var(--shadow-md)] xl:block"
  data-reveal
  data-spotlight
>
  <div class="h-1.5 bg-[image:var(--gradient-brand)]" aria-hidden="true"></div>
  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-left text-sm">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="border-line bg-surface-sunken/70 border-b">
          {
            columns.map((column) => (
              <th
                scope="col"
                class="text-muted px-4 py-4 align-top font-mono text-[0.68rem] leading-snug font-semibold tracking-[0.1em] uppercase first:pl-7 last:pr-7"
              >
                <span class="text-accent mb-2 flex">
                  <ColumnGlyph column={column.key} class="size-4" />
                </span>
                {column.label}
                {column.footnote && (
                  <a
                    href={`#${noteId}`}
                    class="text-accent-2 hover:text-fg ml-0.5 inline-grid min-w-5 place-items-center rounded-full text-sm leading-none font-bold transition-colors"
                  >
                    {column.footnote}
                    <span class="sr-only"> ({t('see the note under the table')})</span>
                  </a>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          places.map((place) => (
            <tr class="border-line hover:bg-surface-sunken/40 border-b align-top transition-colors last:border-b-0">
              {columns.map((column) => {
                const cell = 'px-4 py-7 first:pl-7 last:pr-7';
                if (column.key === 'where') {
                  return (
                    <td class:list={[cell, 'whitespace-nowrap']}>
                      <a
                        href={place.where.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-link link-underline inline-flex items-center gap-1 font-semibold"
                      >
                        <Icon name="map-pin" class="size-3.5 shrink-0" />
                        {place.where.label}
                      </a>
                    </td>
                  );
                }
                if (column.key === 'name') {
                  return (
                    <th scope="row" class:list={[cell, 'font-normal whitespace-nowrap']}>
                      <a
                        href={localHref(place.name.href)}
                        {...linkAttrs(place.name.href)}
                        class="font-display text-link link-underline inline text-lg leading-snug font-bold"
                      >
                        {place.name.label}
                        <Icon name="arrow-up-right" class="ml-0.5 inline size-4 align-[-0.1em]" />
                      </a>
                    </th>
                  );
                }
                if (column.key === 'notes') {
                  return (
                    <td class:list={[cell, 'min-w-[19rem]']}>
                      <PlaceNotes notes={place.notes} />
                    </td>
                  );
                }
                const value = isText(column.key) ? place[column.key] : undefined;
                return (
                  <td class={cell}>
                    {!value ? (
                      <span class="text-muted" aria-hidden="true">
                        —
                      </span>
                    ) : column.key === 'setting' ? (
                      <Tag tone="accent">
                        <KidsGlyph name="house" class="text-accent size-3.5" />
                        {value}
                      </Tag>
                    ) : column.key === 'cost' ? (
                      <span class="font-display text-xl font-extrabold tracking-tight whitespace-nowrap">
                        {value}
                      </span>
                    ) : (
                      <span class="font-semibold whitespace-nowrap">{value}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

{/* ───────────── Narrow screens: one card per place ───────────── */}
<ul class="grid gap-5 xl:hidden" data-reveal-stagger>
  {
    places.map((place) => (
      <li>
        <article
          class="glow-ring border-line bg-surface-raised relative overflow-hidden rounded-3xl border shadow-[var(--shadow-md)]"
          data-spotlight
        >
          <div class="h-1.5 bg-[image:var(--gradient-brand)]" aria-hidden="true" />
          <span
            class="text-accent-2 absolute top-5 right-5 grid size-11 place-items-center rounded-2xl bg-[color-mix(in_oklch,var(--accent-2)_12%,transparent)]"
            aria-hidden="true"
          >
            <KidsGlyph name="party" class="size-5" />
          </span>

          <div class="grid gap-6 p-4 sm:p-7 md:grid-cols-[1.15fr_1fr] md:gap-8">
            <div>
              <a
                href={place.where.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-link link-underline text-muted inline-flex items-center gap-1 text-xs font-semibold tracking-wide uppercase"
              >
                <Icon name="map-pin" class="size-3.5 shrink-0" />
                {place.where.label}
              </a>
              <h3 class="font-display pr-14 text-2xl leading-tight font-bold tracking-tight">
                <a
                  href={localHref(place.name.href)}
                  {...linkAttrs(place.name.href)}
                  class="text-link link-underline"
                >
                  {place.name.label}
                  <Icon name="arrow-up-right" class="ml-0.5 inline size-5 align-[-0.12em]" />
                </a>
              </h3>

              <dl class="mt-5 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
                {tiles.map((column) => {
                  const value = isText(column.key) ? place[column.key] : undefined;
                  return (
                    <div
                      class:list={[
                        'rounded-2xl p-3.5',
                        column.key === 'cost'
                          ? 'bg-[color-mix(in_oklch,var(--accent)_11%,var(--surface-raised))]'
                          : 'bg-surface-sunken',
                      ]}
                    >
                      <dt class="text-muted flex items-start gap-1.5 font-mono text-[0.65rem] leading-snug font-semibold tracking-[0.1em] uppercase">
                        <ColumnGlyph
                          column={column.key}
                          class="text-accent mt-px size-3.5 shrink-0"
                        />
                        <span>
                          {column.label}
                          {column.footnote && (
                            <a
                              href={`#${noteId}`}
                              class="text-accent-2 ml-0.5 text-xs leading-none font-bold"
                            >
                              {column.footnote}
                              <span class="sr-only"> ({t('see the note under the list')})</span>
                            </a>
                          )}
                        </span>
                      </dt>
                      <dd
                        class:list={[
                          'mt-1.5 whitespace-nowrap',
                          column.key === 'cost'
                            ? 'font-display text-lg font-extrabold tracking-tight'
                            : 'font-semibold',
                        ]}
                      >
                        {value ?? (
                          <span class="text-muted" aria-hidden="true">
                            —
                          </span>
                        )}
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </div>

            {notesColumn && (
              <dl class="border-line border-t pt-5 md:border-t-0 md:border-l md:pt-0 md:pl-8">
                <div>
                  <dt class="text-muted flex items-center gap-1.5 font-mono text-[0.65rem] font-semibold tracking-[0.1em] uppercase">
                    <ColumnGlyph column="notes" class="text-accent size-3.5" />
                    {notesColumn.label}
                  </dt>
                  <dd class="mt-3">
                    <PlaceNotes notes={place.notes} />
                  </dd>
                </div>
              </dl>
            )}
          </div>
        </article>
      </li>
    ))
  }
</ul>
