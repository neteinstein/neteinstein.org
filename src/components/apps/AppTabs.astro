---
/**
 * The tab bar over /my-apps: my mobile apps, my macOS apps, my Chrome extensions and my AI apps. The
 * tabs switch panels in place (`src/scripts/app-tabs.ts`); with JS off they are
 * plain in-page anchors and every panel stays on the page. Games and other
 * people's apps have their own pages, in the menu.
 *
 * The bar sticks under the header, so the other tabs stay in sight however far
 * down a panel someone scrolls; when the header tucks away (`data-sticky-tabs`
 * in `global.css`) it slides up into the header's place.
 */
import { appPlatforms } from '../../data/apps';
import { useI18n } from '../../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { t } = useI18n(Astro);
---

<nav
  aria-label={t('Apps')}
  class:list={['container-page sticky top-[5.25rem] z-30', className]}
  data-app-tabs
  data-sticky-tabs
>
  <ul class="glass border-line flex gap-1 overflow-x-auto rounded-2xl border px-2 shadow-[var(--shadow-sm)]">
    {appPlatforms.map(({ id, title }, index) => (
      <li class="shrink-0">
        <a
          href={`#${id}`}
          data-tab={id}
          aria-current={index === 0 ? 'true' : undefined}
          class="text-muted hover:text-fg aria-[current]:border-accent aria-[current]:text-fg -mb-px inline-block border-b-2 border-transparent px-4 py-3 text-sm font-semibold whitespace-nowrap transition-colors duration-300 sm:text-base"
        >
          {t(title)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  import '../../scripts/app-tabs';
</script>
