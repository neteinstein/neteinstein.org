---
import { Image } from 'astro:assets';
import type { AppListing } from '../../data/types';
import { useI18n } from '../../i18n';

/**
 * The app icons, each jumping to that app further down the page.
 *
 * A phone-style glass dock under the hero copy (the hero's right half holds
 * the demo video): icons pop in one by one, bob gently and magnify under the
 * pointer (neighbours grow a little too). Placed inside `PageHero`'s default
 * slot. All CSS.
 */
interface Props {
  apps: AppListing[];
  /** Load-in delay (ms) of the first icon; the rest follow 80ms apart. */
  delay?: number;
  class?: string;
}

const { apps, delay = 0, class: className } = Astro.props;
const { t } = useI18n(Astro);
---

<div class:list={['dock-slot', className]}>
  <nav aria-label={t('Apps on this page')} class="dock-nav max-w-full">
    <ul class="glass border-line flex flex-wrap items-end justify-center gap-2.5 rounded-[1.9rem] border p-2.5 shadow-[var(--shadow-lg)] sm:gap-3 sm:p-3">
      {apps.map((app, index) => (
        <li data-enter style={`--delay: ${delay + index * 80}`}>
          <a href={`#${app.id}`} class="dock-item group relative block rounded-[24%]">
            <span
              class="dock-bob block"
              style={`animation-delay: -${(index * 1.3).toFixed(1)}s`}
              aria-hidden="true"
            >
              <Image
                src={app.icon}
                alt=""
                widths={[64, 128]}
                sizes="4rem"
                class="size-12 rounded-[24%] shadow-[var(--shadow-md)] sm:size-16 lg:size-11 xl:size-14"
                loading="eager"
              />
            </span>
            <span class="dock-label glass border-line text-fg pointer-events-none absolute top-full left-1/2 mt-2 -translate-x-1/2 rounded-full border px-2.5 py-1 text-xs font-semibold whitespace-nowrap opacity-0 shadow-[var(--shadow-md)] transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
              {app.title}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .dock-slot {
    display: flex;
  }

  .dock-item {
    transform-origin: 50% 100%;
    transition:
      scale 0.35s var(--ease-spring),
      translate 0.35s var(--ease-spring);
  }

  :global(.motion-ok) .dock-bob {
    animation: app-bob 5s ease-in-out infinite;
  }
  @keyframes app-bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -4px;
    }
  }

  /* Magnify the hovered icon, and its neighbours a little. */
  .dock-item:hover,
  .dock-item:focus-visible {
    scale: 1.3;
    translate: 0 -0.4rem;
  }
  li:has(+ li > .dock-item:hover) > .dock-item,
  li:has(> .dock-item:hover) + li > .dock-item {
    scale: 1.12;
    translate: 0 -0.15rem;
  }
</style>
