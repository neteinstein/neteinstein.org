---
import { mythGroups } from '../../data/myths';

/**
 * A group of myths ("Global Myths", "Portuguese Myths"), used from
 * `myths.mdx` as `<MythGroup id="…">` around its `<Myth>` blocks. The title
 * comes from `src/data/myths.ts`.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const group = mythGroups.find((entry) => entry.id === id);
if (!group) throw new Error(`Unknown myth group: ${id}`);
---

<section id={group.id} class="scroll-mt-24 py-10 sm:py-14">
  <header class="mb-8 flex items-end gap-5 sm:mb-10" data-reveal>
    <h2 class="font-display text-4xl font-extrabold tracking-tight sm:text-6xl">
      {group.title}
    </h2>
    <span
      class="mb-3 hidden h-px flex-1 bg-[image:var(--gradient-brand)] opacity-60 sm:block"
      aria-hidden="true"></span>
  </header>
  <div class="space-y-8 sm:space-y-10">
    <slot />
  </div>
</section>
