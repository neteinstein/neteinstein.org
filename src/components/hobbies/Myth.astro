---
import { Image } from 'astro:assets';
import Prose from '../Prose.astro';
import Icon from '../Icon.astro';
import { mythGroups } from '../../data/myths';

/**
 * One myth on /hobbies/myths, used from `myths.mdx` as `<Myth id="…">prose</Myth>`.
 * A case-file card: the meme on one side (pinned while the prose scrolls,
 * and a link to the full-size picture), the debunking on the other, and the
 * supporting scans, if any, in a strip underneath.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const all = mythGroups.flatMap((group) => group.myths);
const index = all.findIndex((myth) => myth.id === id);
const myth = all[index];
if (!myth) throw new Error(`Unknown myth: ${id}`);

const number = String(index + 1).padStart(2, '0');
const sources = myth.sources ?? [];
---

<article
  id={myth.id}
  lang={myth.lang}
  class="group/myth border-line bg-surface-raised relative scroll-mt-24 overflow-hidden rounded-[2rem] border p-5 shadow-[var(--shadow-md)] sm:p-8 lg:p-10"
  data-reveal
>
  <div
    class="pointer-events-none absolute -top-24 -left-24 size-72 rounded-full bg-[radial-gradient(closest-side,var(--glow-a),transparent)] opacity-70"
    aria-hidden="true"
  >
  </div>

  <div class="relative grid gap-8 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <figure class="lg:sticky lg:top-28">
        <a
          href={myth.figure.image.src}
          class="group/zoom glow-ring border-line bg-surface-sunken relative block overflow-hidden rounded-3xl border"
        >
          <Image
            src={myth.figure.image}
            alt={myth.figure.alt}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 26rem, 100vw"
            class="h-auto w-full transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover/zoom:scale-[1.03]"
          />
          <span
            class="glass text-fg absolute right-3 bottom-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-mono text-[0.7rem] font-semibold tracking-wider uppercase opacity-90 transition-opacity group-hover/zoom:opacity-100"
            lang="en"
          >
            Full size
            <Icon name="arrow-up-right" class="size-3.5" />
          </span>
        </a>
      </figure>
    </div>

    <div class="min-w-0 lg:col-span-7">
      <p class="eyebrow flex items-center gap-3" lang="en">
        <span>Myth</span>
        <span class="text-gradient font-display text-2xl tracking-tight">#{number}</span>
      </p>
      <h3
        class="font-display mt-3 text-2xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl"
      >
        {myth.title}
      </h3>
      <div class="mt-6">
        <Prose>
          <slot />
        </Prose>
      </div>
    </div>
  </div>

  {
    sources.length > 0 && (
      <ul class="relative mt-10 grid gap-4 sm:grid-cols-3" data-reveal-stagger>
        {sources.map((source) => (
          <li>
            <a
              href={source.image.src}
              class="group/scan glow-ring border-line bg-surface-sunken block overflow-hidden rounded-2xl border shadow-[var(--shadow-sm)] transition-transform duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1"
            >
              <Image
                src={source.image}
                alt={source.alt}
                widths={[400, 640, 960]}
                sizes="(min-width: 640px) 22rem, 100vw"
                class="aspect-[3/2] w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover/scan:scale-[1.04]"
              />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
