---
import { useI18n } from '../../i18n';

/**
 * In-page index for a hero: numbered pill links to the page's blocks.
 * Goes in PageHero's `actions` slot.
 */
interface Props {
  items: { id: string; label: string }[];
  label?: string;
}

const { items, label = useI18n(Astro).t('On this page') } = Astro.props;
---

<nav aria-label={label} class="w-full">
  <ul class="flex flex-wrap gap-2.5">
    {
      items.map((item, index) => (
        <li>
          <a
            href={`#${item.id}`}
            class="glass border-line-strong text-fg hover:border-accent group inline-flex items-center gap-2.5 rounded-full border py-2 pr-4 pl-2 text-sm font-semibold transition-all duration-300 ease-[var(--ease-spring)] hover:-translate-y-0.5 hover:shadow-[var(--shadow-md)]"
          >
            <span class="bg-surface-sunken text-accent grid size-7 place-items-center rounded-full font-mono text-[0.7rem] transition-colors group-hover:bg-[image:var(--gradient-brand)] group-hover:text-[var(--on-accent)]">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
