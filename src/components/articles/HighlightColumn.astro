---
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import type { ArticleHighlightGroup } from '../../data/types';
import { hostOf } from './host';

/**
 * One "… highlights" column: the years as a small timeline, each with the
 * articles published that year.
 */
interface Props {
  group: ArticleHighlightGroup;
  icon: IconName;
  /** Accent token for the decoration (`--accent-2`); text stays on `fg`/`muted`. */
  tone: '--accent' | '--accent-2' | '--accent-3' | '--accent-4';
}

const { group, icon, tone } = Astro.props;
---

<article
  class="border-line bg-surface-raised relative flex h-full flex-col overflow-hidden rounded-3xl border p-6 shadow-[var(--shadow-sm)] sm:p-7"
  style={`--tone: var(${tone})`}
  data-spotlight
>
  <div
    class="pointer-events-none absolute -top-20 -right-20 size-48 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--tone)_28%,transparent),transparent)]"
    aria-hidden="true"
  >
  </div>
  <header class="relative flex items-center gap-3.5">
    <span
      class="grid size-11 shrink-0 place-items-center rounded-2xl bg-[color-mix(in_oklch,var(--tone)_16%,transparent)] text-[color-mix(in_oklch,var(--tone)_70%,var(--text))]"
    >
      <Icon name={icon} class="size-5" />
    </span>
    <h3 class="font-display text-xl leading-tight font-bold tracking-tight">{group.title}</h3>
  </header>

  <ol class="relative mt-7 ml-1.5 space-y-7 pl-6">
    <span
      class="absolute top-2 bottom-2 left-0 w-0.5 rounded-full bg-[linear-gradient(to_bottom,var(--tone),color-mix(in_oklch,var(--tone)_10%,transparent))]"
      aria-hidden="true"></span>
    {
      group.years.map((entry) => (
        <li class="relative">
          <span
            class="bg-surface-raised absolute top-1 -left-6 size-3.5 -translate-x-[5px] rounded-full border-[3px] border-[var(--tone)]"
            aria-hidden="true"
          />
          <p class="font-display text-2xl leading-none font-extrabold tracking-tight">
            {entry.year}
          </p>
          <ul class="mt-3 space-y-3">
            {entry.articles.map((article) => (
              <li>
                <a
                  href={article.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/link hover:text-link block leading-snug font-medium text-pretty transition-colors"
                >
                  {article.label}
                  <Icon
                    name="arrow-up-right"
                    class="text-accent ml-0.5 inline size-3.5 align-[-0.1em] opacity-60 transition-[opacity,translate] group-hover/link:translate-x-0.5 group-hover/link:opacity-100"
                  />
                </a>
                <span class="text-muted mt-0.5 block font-mono text-[0.7rem]">
                  {hostOf(article.href)}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</article>
