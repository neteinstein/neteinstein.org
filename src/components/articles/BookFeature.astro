---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import RichText from '../RichText.astro';
import type { AuthoredBook } from '../../data/types';

/**
 * A book Pedro wrote or contributed to: a tilted cover that straightens on
 * hover, the title (linked when the original linked it) and the blurb.
 */
interface Props {
  book: AuthoredBook;
  /** Status chip over the cover — a short UI label. */
  badge?: string;
}

const { book, badge } = Astro.props;
---

<article
  class="group glow-ring border-line bg-surface-raised relative flex h-full flex-col gap-6 overflow-hidden rounded-3xl border p-5 shadow-[var(--shadow-sm)] transition-[translate,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-[var(--shadow-lg)] sm:flex-row sm:p-6"
  data-spotlight
>
  <div class="relative mx-auto w-44 shrink-0 sm:mx-0 sm:w-48">
    <div
      class="absolute -inset-3 -z-0 rounded-3xl bg-[image:var(--gradient-brand)] opacity-20 blur-2xl"
      aria-hidden="true"
    >
    </div>
    <Image
      src={book.image}
      alt={book.imageAlt}
      widths={[240, 400]}
      sizes="12rem"
      class="border-line relative aspect-square w-full -rotate-3 rounded-2xl border object-cover shadow-[var(--shadow-lg)] transition-transform duration-700 ease-[var(--ease-spring)] group-hover:scale-[1.03] group-hover:rotate-0"
    />
    {
      badge && (
        <span class="glass border-line text-fg absolute -bottom-2 left-1/2 -translate-x-1/2 rounded-full border px-3 py-1 font-mono text-[0.68rem] font-semibold tracking-wider whitespace-nowrap uppercase shadow-[var(--shadow-md)]">
          {badge}
        </span>
      )
    }
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center">
    <h3 class="font-display text-2xl leading-tight font-bold tracking-tight text-balance">
      {
        book.href ? (
          <a
            href={book.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-link transition-colors"
          >
            {book.title}
            <Icon
              name="arrow-up-right"
              class="text-accent ml-1 inline size-5 align-[-0.1em] transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        ) : (
          book.title
        )
      }
    </h3>
    <p class="text-muted mt-3 leading-relaxed text-pretty">
      <RichText text={book.description} />
    </p>
  </div>
</article>
